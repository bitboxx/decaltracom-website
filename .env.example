# Cloudflare API token used by `yarn deploy`.
# Create one at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Account > Cloudflare Pages > Edit
CLOUDFLARE_API_TOKEN=

# Simple Analytics (EU-hosted, cookieless). Set to "on" to emit the script;
# anything else and no analytics load at all.
PUBLIC_ANALYTICS=

# Overrides the mailer Worker endpoint. Leave empty in production; point it at a
# local stub when testing the forms so no mail is actually sent.
PUBLIC_MAILER_URL=
