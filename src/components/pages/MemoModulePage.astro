      padding-top: 33px;
    }
    .hero-header {
      margin-bottom: 28px;
    }
    h1 {
      margin: 18px 0 12px;
    }
    .hero-subtitle {
      font-size: 14px;
      line-height: 1.8;
    }
    .hero-stage {
