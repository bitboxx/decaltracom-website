<script>
  const root = document.querySelector<HTMLElement>('[data-memo-page]');
  if (root) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('.step-tab')
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>('[role="tabpanel"]')
    );
    const tablist = root.querySelector<HTMLElement>('.step-list');
    const orientation = window.matchMedia('(max-width:800px)');
    function selectTab(tab: HTMLButtonElement, focus = false) {
      for (const item of tabs) {
        const active = item === tab;
        item.setAttribute('aria-selected', String(active));
        item.tabIndex = active ? 0 : -1;
      }
      for (const panel of panels)
        panel.hidden = panel.id !== tab.getAttribute('aria-controls');
      if (focus) tab.focus();
    }
    function resetTabs() {
      if (tabs[0]) selectTab(tabs[0]);
    }
    resetTabs();
    // A browser Back/Forward restore should also start at the first option.
    window.addEventListener('pageshow', resetTabs);
    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', event => {
        let next: number;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight')
          next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft')
          next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        selectTab(tabs[next], true);
      });
    }
    function updateOrientation() {
      tablist?.setAttribute(
        'aria-orientation',
        orientation.matches ? 'horizontal' : 'vertical'
      );
    }
    orientation.addEventListener('change', updateOrientation);
    updateOrientation();
    const citations = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-source-target]')
    );
    const sources = Array.from(
      root.querySelectorAll<HTMLElement>('[data-source-panel]')
    );
    for (const citation of citations) {
      citation.addEventListener('click', () => {
        const target = citation.dataset.sourceTarget;
        if (!target) return;
        for (const button of citations)
          button.setAttribute(
            'aria-pressed',
            String(button.dataset.sourceTarget === target)
          );
        for (const source of sources) source.hidden = source.id !== target;
      });
    }
  }
</script>
