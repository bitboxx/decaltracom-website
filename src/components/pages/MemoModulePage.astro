      padding: 32px 0;
    }
    .outcome-top {
      display: block;
    }
    .outcome h3 {
      margin-top: 6px;
      font-size: 18px;
    }
    .outcome p {
      padding-left: 0;
      font-size: 12px;
    }
    .workflow {
      padding: 49px 0;
    }
    .section-heading {
      align-items: flex-start;
    }
    .section-heading .pill {
      display: none;
    }
    .section-heading h2 {
      font-size: 30px;
    }
    .workflow-grid {
      grid-template-columns: 1fr;
      gap: 23px;
    }
    .step-list {
      flex-direction: row;
      gap: 8px;
    }
    .step-tab {
      flex: 1;
      width: auto;
      border: 1px solid #d4dbda;
      border-bottom: 2px solid transparent;
      border-radius: 8px;
      padding: 13px;
    }
    .step-tab[aria-selected='true'] {
      border-left-color: #d4dbda;
      border-bottom-color: #466b56;
    }
    .step-title {
      gap: 8px;
    }
    .step-label {
      font: 500 13px/1.5 var(--sans);
      letter-spacing: 0;
    }
    .step-arrow,
    .step-copy,
    .step-tab[aria-selected='true'] .step-copy {
      display: none;
    }
    .detail-body {
      min-height: 310px;
    }
    .governance {
      gap: 30px;
      padding: 32px;
      grid-template-columns: 1fr 1.2fr;
    }
    .governance h2 {
      font-size: 27px;
    }
    .connected {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 50px 0;
    }
    .connected-copy {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 30px;
    }
    .connected-copy .eyebrow {
      grid-column: 1/-1;
    }
    .connected-copy p {
      margin-top: 14px;
      font-size: 13px;
    }
    .connected-copy h2 {
      margin-bottom: 0;
      font-size: 30px;
    }
    .module-flow::before {
      right: 90px;
    }
    .module h3 {
      font-size: 18px;
    }
    .module p {
      max-width: 185px;
    }
    .closing h2 {
      font-size: 30px;
    }
    .closing p {
      font-size: 14px;
    }
  }
  @media (max-width: 540px) {
    .wrap {
      width: calc(100% - 32px);
    }
