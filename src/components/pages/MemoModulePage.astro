  /* Memo-specific product illustrations. */
  .memo-canvas {
    min-width: 0;
    padding: 20px 24px;
    background: #edf1ef;
  }
  .memo-paper {
    position: relative;
    padding: 23px 23px 16px;
    background: #fff;
    border: 1px solid #d5ddd8;
    border-radius: 4px;
    box-shadow: 0 7px 20px #1d3e2c0a;
  }
  .memo-paper-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
    margin-bottom: 13px;
    border-bottom: 1px solid #dce3de;
  }
  .memo-paper-top span {
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .memo-paper-top small {
    color: #7b8980;
    font-size: 9px;
  }
  .memo-paper h3 {
    font-size: 18px;
    line-height: 1.35;
    margin-bottom: 4px;
  }
  .memo-paper .paper-meta {
    font-size: 9px;
    color: #76857b;
    margin-bottom: 16px;
  }
  .memo-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 18px;
    padding: 12px 13px;
    background: #f2f6f3;
    border: 1px solid #e0e8e2;
    border-radius: 7px;
  }
  .memo-fact span {
    display: block;
    color: #6c7e71;
    font-size: 9px;
  }
  .memo-fact strong {
    display: block;
    font: 500 20px/1.4 var(--display);
    letter-spacing: -0.5px;
    color: #2e4d38;
    margin-top: 3px;
  }
  .memo-section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 10px;
    font-weight: 600;
    color: #304b39;
    margin-bottom: 8px;
  }
  .memo-section-label small {
    color: #6e8476;
    font-size: 8px;
    font-weight: 450;
  }
  .memo-paper p {
    font-size: 10px;
    line-height: 1.85;
    color: #617368;
  }
  .paper-cite {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 15px;
    height: 15px;
    background: #e6eee8;
    color: #3f674d;
    font: 500 8px/1 var(--sans);
    border-radius: 3px;
    vertical-align: 1px;
  }
  .memo-mini-table {
    margin-top: 13px;
    font-size: 9px;
  }
  .memo-mini-table div {
    display: flex;
    align-items: center;
    justify-content: space-between;
