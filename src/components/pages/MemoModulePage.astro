    .hero-story p {
      font-size: 14px;
      margin-top: 0;
    }
    .hero-story .text-link {
      margin-top: 15px;
    }
    .quiet-line {
      margin-top: 19px;
      font-size: 11px;
    }
    .workspace-head {
      padding: 13px;
    }
    .workspace-label {
      font-size: 9px;
    }
    .workspace-body {
      display: block;
    }
    .app-sidebar {
      display: none;
    }
    .figure-caption {
      font-size: 9px;
    }
    .outcomes {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 28px 5px 33px;
    }
    .outcome-top {
      display: flex;
      gap: 12px;
      margin-bottom: 5px;
    }
    .outcome h3 {
      font-size: 20px;
      margin-top: 0;
    }
    .outcome p {
      padding-left: 29px;
      font-size: 13px;
      max-width: none;
    }
    .workflow {
      padding: 38px 0;
    }
    .section-heading h2 {
      font-size: 28px;
    }
    .step-list {
      gap: 6px;
    }
    .step-tab {
      padding: 12px 7px;
    }
    .step-number {
      display: none;
    }
    .step-label {
      font-size: 11px;
    }
    .step-title {
      justify-content: center;
    }
    .detail-top {
      padding: 15px;
      gap: 12px;
    }
    .detail-top strong {
      font-size: 12px;
    }
    .detail-top small {
      font-size: 9px;
    }
    .detail-body {
      padding: 19px 14px;
      min-height: 0;
    }
    .model-meta {
      gap: 10px;
      margin-bottom: 21px;
    }
    .model-meta .pill {
      padding: 4px 7px;
      font-size: 9px;
    }
    .model-meta strong {
      font-size: 11px;
    }
    .model-meta p {
      font-size: 10px;
    }
    .detail-foot {
      padding: 13px 14px;
      font-size: 10px;
    }
    .detail-foot .check-circle {
      width: 17px;
      height: 17px;
      font-size: 10px;
    }
    .governance {
      grid-template-columns: 1fr;
      padding: 28px 24px;
      gap: 28px;
      border-radius: 18px;
    }
    .governance h2 {
      font-size: 29px;
    }
    .governance p {
      font-size: 13px;
    }
    .governance-item p {
      font-size: 12px;
    }
    .connected {
      padding: 43px 0;
      gap: 30px;
    }
    .connected-copy {
      display: block;
    }
    .connected-copy h2 {
      font-size: 29px;
      margin: 13px 0;
    }
    .connected-copy p {
      margin-top: 0;
    }
    .module-flow-grid {
      gap: 12px;
    }
    .module-symbol {
