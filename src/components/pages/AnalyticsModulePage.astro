---
import AnalyticsWorkspace from '../illustrations/AnalyticsWorkspace.astro';
---

<div
  id="analytics-module-page"
  class="analytics-module-page wrap"
  data-analytics-page=""
>
  <section class="hero" aria-labelledby="an-page-title">
    <div class="hero-header">
      <span class="eyebrow">Credit Decisioning</span>
      <h1 id="an-page-title">Analytics</h1>
      <p class="hero-subtitle">
        Generate transparent quantitative and qualitative scores from your
        credit models
      </p>
    </div>
    <figure data-screenshot-slot="01">
      <div class="hero-stage">
        <div class="hero-story">
          <span class="eyebrow">Your models. Clearer decisions.</span>
          <h2>Every score<br />has a story</h2>
          <p>
            Combine your numbers with AI-generated qualitative assessments that
            your analysts can review and refine
          </p>
          <a class="text-link" href="#an-workflow"
            >See how it works <span class="arrow" aria-hidden="true">↗</span></a
          >
          <div class="quiet-line">
            <span class="check-circle" aria-hidden="true">✓</span> Automated first
            pass · Analyst review
          </div>
        </div>
        <AnalyticsWorkspace />
      </div>
      <figcaption class="figure-caption">
        Illustrative views · Not actual screenshot · Fictional data
      </figcaption>
      <!-- Screenshot 01 · Analytics overview. Show a real company assessment with the model name, overall result and quantitative / qualitative score breakdown. Replace the interface on the right while retaining the headline on the left. -->
    </figure>
    <div class="outcomes" aria-label="Key benefits">
      <div class="outcome">
        <div class="outcome-top">
          <span class="index">01</span><h3>Your models in practice</h3>
        </div><p>
          Apply your credit approach consistently across companies and teams
        </p>
      </div>
      <div class="outcome">
        <div class="outcome-top">
          <span class="index">02</span><h3>Automate the first pass</h3>
        </div><p>
          Let AI prepare qualitative assessments so your analysts can focus on
          review and refinement
        </p>
      </div>
      <div class="outcome">
        <div class="outcome-top">
          <span class="index">03</span><h3>Clarity behind the score</h3>
        </div><p>
          See what drives each result so your team can review it with confidence
        </p>
      </div>
    </div>
  </section>

  <section
    id="an-workflow"
    class="workflow"
    aria-labelledby="an-workflow-title"
  >
    <div class="section-heading">
      <div>
        <span class="eyebrow">From inputs to understanding</span><h2
          id="an-workflow-title"
        >
          See the score<br />Understand what’s behind it
        </h2>
      </div><span class="pill">Your analysts stay in control</span>
    </div>
    <div class="workflow-grid">
      <div
        class="step-list"
        role="tablist"
        aria-label="Explore the Analytics workflow"
        aria-orientation="vertical"
      >
        <button
          class="step-tab"
          id="an-numbers-tab"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="an-numbers-panel"
          tabindex="0"
          ><span class="step-title"
            ><span class="step-number">01</span><span class="step-label"
              >Start with the numbers</span
            ><span class="step-arrow" aria-hidden="true">↗</span></span
          ><span class="step-copy"
            >Use reviewed financials and credit-adjusted metrics as the
            foundation for your quantitative score</span
          ></button
        >
        <button
          class="step-tab"
          id="an-judgement-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="an-judgement-panel"
          tabindex="-1"
          ><span class="step-title"
            ><span class="step-number">02</span><span class="step-label"
              >Automate and review</span
            ><span class="step-arrow" aria-hidden="true">↗</span></span
          ><span class="step-copy"
            >Let AI prepare qualitative assessments with supporting evidence so
            analysts can review the answer and refine the rationale</span
          ></button
        >
        <button
          class="step-tab"
          id="an-result-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="an-result-panel"
          tabindex="-1"
          ><span class="step-title"
            ><span class="step-number">03</span><span class="step-label"
              >Understand the result</span
            ><span class="step-arrow" aria-hidden="true">↗</span></span
          ><span class="step-copy"
            >See how inputs and model weights shape the score before carrying
            the result into your decision</span
          ></button
        >
      </div>
      <div class="workflow-panels">
        <div
          id="an-numbers-panel"
          data-screenshot-slot="02"
          role="tabpanel"
          aria-labelledby="an-numbers-tab"
        >
          <div class="detail-window">
            <div class="detail-top">
              <strong>A clear starting point</strong><small
                >Quantitative inputs</small
              >
            </div>
            <div class="detail-body">
              <div class="model-meta">
                <div>
                  <strong>Northstar Manufacturing</strong><p>
                    FY 2024 · Credit-adjusted metrics
                  </p>
                </div><span class="pill good">Reviewed financials</span>
              </div>
              <table class="input-table">
                <caption hidden
                  >Illustrative quantitative factors and weights in the total
                  score</caption
                ><thead
                  ><tr
                    ><th scope="col">Model input</th><th scope="col">Value</th
                    ><th scope="col">Score / 100</th><th scope="col">Weight</th
                    ></tr
                  ></thead
                ><tbody>
                  <tr class="selected"
                    ><td>Net debt / EBITDA</td><td>2.50×</td><td>60</td><td
                      >25%</td
                    ></tr
                  >
                  <tr
                    ><td>Interest coverage</td><td>6.20×</td><td>72</td><td
                      >25%</td
                    ></tr
                  >
                  <tr
                    ><td>EBITDA margin</td><td>19.5%</td><td>80</td><td>15%</td
                    ></tr
                  >
                  <tr
                    ><td>Current ratio</td><td>1.45×</td><td>70</td><td>10%</td
                    ></tr
                  >
                </tbody>
              </table>
              <div class="evidence-line">
                <span aria-hidden="true">↳</span> Net debt €34.0m / Adjusted EBITDA
                €13.6m · From Financial spreading
              </div>
            </div>
            <div class="detail-foot">
              <span class="check-circle" aria-hidden="true">✓</span> Follow each input
              back to the financials behind it
            </div>
          </div>
          <p class="panel-caption">
            Illustrative views · Not actual screenshot · Fictional data
          </p>
          <!-- Screenshot 02 · Quantitative inputs. Show the ratios used in the model with their values and weights. Include the connection to reviewed or credit-adjusted financials. -->
        </div>
        <div
          id="an-judgement-panel"
          data-screenshot-slot="03"
          role="tabpanel"
          aria-labelledby="an-judgement-tab"
          hidden
        >
          <div class="detail-window">
            <div class="detail-top">
              <strong>AI prepares the assessment</strong><small
                >Your analyst reviews it</small
              >
            </div>
            <div class="detail-body">
              <div
                class="review-path"
                aria-label="Qualitative workflow: AI generates a draft, then the analyst reviews and refines it"
              >
                <strong>AI-generated draft</strong><span
                  class="arrow"
                  aria-hidden="true">→</span
                ><span>Analyst review and refinement</span>
              </div>
              <div class="judgement-grid">
                <div>
                  <div class="assessment-label">
                    Business profile · Competitive position
                  </div><div class="assessment-title">
                    How resilient is the company’s market position?
                  </div><div
                    class="rating-options"
                    aria-label="Illustrative AI-suggested assessment awaiting analyst review: Established"
                  >
                    <span>Leading</span><span class="selected">Established</span
                    ><span>Challenged</span>
                  </div><div class="rationale">
                    <strong>AI-generated rationale · Draft</strong><p>
                      An established supplier with long-standing customer
                      relationships. Exposure to a small number of customers
                      remains a consideration.
                    </p>
                  </div>
                </div>
                <aside class="evidence-card">
                  <h3>Supporting context</h3><p>
                    The five largest customers account for 42% of revenue
                  </p><div class="evidence-ref">
                    Annual report 2024<br />Business review · Page 12
                  </div><div class="evidence-ref">
                    Management discussion<br />Customer relationships
                  </div>
                </aside>
              </div>
              <div class="assessment-summary">
                <span>Suggested score <strong>60 / 100</strong></span><span
                  >Model weight <strong>15%</strong></span
                >
              </div>
              <div class="review-note">
                <strong>Ready for analyst review</strong><p>
                  Your analyst can check the evidence and confirm or refine the
                  suggested assessment and rationale
                </p>
              </div>
            </div>
            <div class="detail-foot">
              <span class="check-circle" aria-hidden="true">✓</span> Automate the
              first pass while keeping analysts in control
            </div>
          </div>
          <p class="panel-caption">
            Illustrative views · Not actual screenshot · Fictional data
          </p>
          <!-- Screenshot 03 · Automated assessment and analyst review. Show an AI-generated answer with its supporting evidence and draft rationale. Include the analyst’s review controls so it is clear they can confirm or refine the assessment. -->
        </div>
        <div
          id="an-result-panel"
          data-screenshot-slot="04"
          role="tabpanel"
          aria-labelledby="an-result-tab"
          hidden
        >
          <div class="detail-window">
            <div class="detail-top">
              <strong>Make the result explainable</strong><small
                >Corporate credit model · v2.1</small
              >
            </div>
            <div class="detail-body">
              <table class="input-table compact">
                <caption hidden>Example model score calculation</caption><thead
                  ><tr
                    ><th scope="col">Factor</th><th scope="col">Score / 100</th
                    ><th scope="col">Weight</th><th scope="col">Points</th></tr
                  ></thead
                ><tbody>
                  <tr><td>Leverage</td><td>60</td><td>25%</td><td>15.0</td></tr>
                  <tr
                    ><td>Debt service</td><td>72</td><td>25%</td><td>18.0</td
                    ></tr
                  >
                  <tr
                    ><td>Profitability</td><td>80</td><td>15%</td><td>12.0</td
                    ></tr
                  >
                  <tr><td>Liquidity</td><td>70</td><td>10%</td><td>7.0</td></tr>
                  <tr
                    ><td>Business profile</td><td>60</td><td>15%</td><td>9.0</td
                    ></tr
                  >
                  <tr><td>Management</td><td>70</td><td>10%</td><td>7.0</td></tr
                  >
                  <tr class="sum"
                    ><td>Combined score</td><td></td><td>100%</td><td>68.0</td
                    ></tr
                  >
                </tbody>
              </table>
              <div class="score-result">
                <span>Model result <small>· Internal scale</small></span><strong
                  >BBB−</strong
                >
              </div>
            </div>
            <div class="detail-foot">
              <span class="check-circle" aria-hidden="true">✓</span> From each factor
              to its contribution to the score
            </div>
          </div>
          <p class="panel-caption">
            Illustrative views · Not actual screenshot · Fictional data
          </p>
          <!-- Screenshot 04 · Score breakdown. Show the actual model result with its factor scores, weights and contributions. Use your own internal rating scale. -->
        </div>
      </div>
    </div>
  </section>

  <section class="governance" aria-labelledby="an-governance-title">
    <div>
      <span class="eyebrow">Transparent by design</span><h2
        id="an-governance-title"
      >
        Your framework<br />Not a black box
      </h2><p>
        Bring automation to your credit approach while keeping the logic and the
        judgement open to review
      </p>
    </div>
    <div class="governance-list">
      <div class="governance-item">
        <span class="check-circle" aria-hidden="true">✓</span><div>
          <h3>Your model logic</h3><p>
            Use the factors and weights that reflect how you assess credit
          </p>
        </div>
      </div>
      <div class="governance-item">
        <span class="check-circle" aria-hidden="true">✓</span><div>
          <h3>Automation with analyst review</h3><p>
            Let AI prepare the qualitative assessment for your analysts to
            review and refine
          </p>
        </div>
      </div>
      <div class="governance-item">
        <span class="check-circle" aria-hidden="true">✓</span><div>
          <h3>A traceable result</h3><p>
            Connect the score to the inputs and evidence that support it
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    id="an-connected"
    class="connected"
    aria-labelledby="an-connected-title"
  >
    <div class="connected-copy">
      <span class="eyebrow">Part of the bigger decision</span><h2
        id="an-connected-title"
      >
        From a clear score<br />to a stronger decision
      </h2><p>
        Build on reviewed financials and credit-adjusted metrics from Financial
        spreading and carry the score and its rationale into Memo
      </p>
    </div>
    <div class="module-flow">
      <div class="module-flow-grid">
        <a class="module" href="/credit-decisioning/financial-spreading"
          ><div class="module-symbol">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><rect x="4" y="4" width="16" height="16" rx="1"></rect><path
                d="m5 16 5-6 4 4 5-7"></path></svg
            >
          </div><h3>Financial spreading</h3><p>
            Reviewed financials and credit-adjusted metrics
          </p></a
        >
        <div class="module active">
          <div class="module-symbol">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M6 20v-6m6 6V8m6 12V3"></path></svg
            >
          </div><h3>Analytics</h3><p>
            Transparent quantitative and qualitative scores
          </p>
        </div>
        <a class="module" href="/credit-decisioning/memo"
          ><div class="module-symbol">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M6 3h8l4 4v14H6V3Z"></path><path
                d="M14 3v5h4M9 12h6m-6 4h6"></path></svg
            >
          </div><h3>Memo</h3><p>Decision-ready credit memos</p></a
        >
      </div>
      <div class="flow-footnote">
        <span class="check-circle" aria-hidden="true">✓</span> Connected modules on
        one governed foundation
      </div>
    </div>
  </section>
  <section class="closing" aria-labelledby="an-closing-title">
    <div class="closing-copy">
      <h2 id="an-closing-title">Interested?</h2><p>
        See how DecAltra can bring your credit models into a clearer decision
        process
      </p>
    </div>
    <div class="closing-actions">
      <button
        class="button"
        type="button"
        command="show-modal"
        commandfor="demo-request-modal">Request a demo</button
      ><a class="text-link" href="/contact"
        >Contact us <span class="arrow" aria-hidden="true">→</span></a
      >
    </div>
  </section>
</div>

<!-- Scoped to Analytics so the existing website layout and other pages remain unchanged. -->
<style>
  .analytics-module-page {
    color-scheme: light;
    --page: #f1f3f3;
    --paper: #fff;
    --ink: #0b1011;
    --body: #526066;
    --muted: #6b787d;
    --line: #dbe1e1;
    --soft: #f7f9f9;
    --green: #396456;
    --green-bg: #edf4f0;
    --display: var(--font-display);
    --sans: var(--font-sans);
  }
  * {
    box-sizing: border-box;
  }
  .analytics-module-page {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font: 15px/1.6 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  button,
  input {
    font: inherit;
  }
  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }
  button {
    cursor: pointer;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  h1,
  h2,
  h3,
  p,
  figure {
    margin: 0;
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-variation-settings: 'wdth' 112.5;
    font-weight: 450;
    letter-spacing: -0.045em;
  }
  p {
    color: var(--body);
  }
  button:focus-visible,
  a:focus-visible,
  input:focus-visible,
  summary:focus-visible {
    outline: 2px solid #477765;
    outline-offset: 5px;
  }
  [hidden] {
    display: none !important;
  }
  .wrap {
    width: min(1280px, calc(100% - 80px));
    margin-inline: auto;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 11px;
    line-height: 1.4;
    white-space: nowrap;
  }
  .pill.good {
    background: var(--green-bg);
    border-color: #d8e6dd;
    color: var(--green);
  }
  .pill.good::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 21px;
    border: 1px solid var(--ink);
    border-radius: 99px;
    background: var(--ink);
    color: white;
    font-size: 13px;
    font-weight: 550;
    line-height: 1.6;
    white-space: nowrap;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .button:hover {
    background: #303a3c;
    transform: translateY(-1px);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 8px 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-size: 13px;
    font-weight: 550;
    white-space: nowrap;
  }
  .arrow {
    font:
      21px/1 Arial,
      sans-serif;
  }
  .hero {
    padding-top: 46px;
  }
  .hero-header {
    text-align: center;
    margin-bottom: 42px;
  }
  .hero-header .eyebrow {
    display: inline-flex;
    border: 1px solid #d3dada;
    border-radius: 99px;
    background: #ffffff80;
    padding: 5px 12px;
    font-weight: 500;
  }
  h1 {
    margin: 21px 0 15px;
    font-size: clamp(38px, 4.5vw, 60px);
    line-height: 1.15;
  }
  .hero-subtitle {
    font-size: 18px;
    line-height: 1.7;
  }
  .hero-stage {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.7fr);
    gap: 38px;
    align-items: center;
    background: linear-gradient(122deg, #e8ecec, #e4e9e7 70%, #edf0ef);
    border: 1px solid #dce2e0;
    border-radius: 22px;
    padding: 38px 0 38px 40px;
    overflow: hidden;
  }
  .hero-story .eyebrow {
    color: #5e6d6a;
    font-size: 10px;
  }
  .hero-story h2 {
    font-size: 37px;
    line-height: 1.17;
    margin: 16px 0 20px;
  }
  .hero-story p {
    max-width: 290px;
    font-size: 14px;
    line-height: 1.85;
  }
  .hero-story .text-link {
    margin-top: 23px;
  }
  .quiet-line {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid #cad4d0;
    font-size: 11px;
    color: #52675f;
  }
  .check-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 11px;
    flex-shrink: 0;
  }
  .workspace {
    min-width: 0;
    border: 1px solid #cbd4cf;
    border-right: 0;
    border-radius: 13px 0 0 13px;
    background: white;
    box-shadow: 0 18px 44px #173b2920;
    overflow: hidden;
  }
  .workspace-head {
    min-height: 47px;
    padding: 12px 19px;
    border-bottom: 1px solid #e4e9e7;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .workspace-mark {
    font: 650 15px/1 var(--display);
    letter-spacing: -0.5px;
  }
  .workspace-label {
    font-size: 10px;
    color: #65746e;
  }
  .workspace-body {
    display: grid;
    grid-template-columns: 125px minmax(0, 1fr);
  }
  .app-sidebar {
    background: #f8faf9;
    border-right: 1px solid #e6ebe8;
    padding: 20px 9px;
  }
  .company {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 3px 25px;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.5;
  }
  .monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid #d4dfda;
    background: #e5ece8;
    border-radius: 7px;
    flex-shrink: 0;
    font-size: 10px;
  }
  .app-menu {
    font-size: 10px;
    color: #6a7872;
    padding: 9px 8px;
    margin: 3px 0;
    border-radius: 6px;
  }
  .app-menu.active {
    background: #e7eeea;
    color: #173f2e;
    font-weight: 600;
  }
  .workspace-content {
    min-width: 0;
    padding: 20px;
  }
  .workspace-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }
  .workspace-title strong {
    display: block;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.3px;
  }
  .workspace-title small {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 10px;
  }
  .workspace-title .pill {
    padding: 4px 8px;
    font-size: 10px;
  }
  .app-tabs {
    display: flex;
    gap: 23px;
    border-bottom: 1px solid #e5eae7;
    color: #66776d;
    font-size: 10px;
    margin-bottom: 17px;
  }
  .app-tabs span {
    padding-bottom: 8px;
  }
  .app-tabs .active {
    border-bottom: 2px solid var(--green);
    color: #224c39;
    font-weight: 600;
  }
  .rating-overview {
    display: grid;
    grid-template-columns: 1fr 1.22fr;
    gap: 22px;
    align-items: center;
    padding: 17px 18px;
    border: 1px solid #dce5df;
    border-radius: 10px;
    background: #f5f8f6;
  }
  .rating-title {
    font-size: 10px;
    color: #587161;
  }
  .rating {
    font: 450 43px/1.25 var(--display);
    letter-spacing: -2px;
  }
  .rating-bottom {
    font-size: 10px;
    color: #63776a;
    margin-top: 4px;
  }
  .rating-bottom strong {
    font-weight: 600;
