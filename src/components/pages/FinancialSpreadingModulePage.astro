---
import FinancialSpreadingWorkspace from '../illustrations/FinancialSpreadingWorkspace.astro';
---

<div
  id="financial-spreading-page"
  class="financial-spreading-page wrap"
  data-financial-spreading-page=""
>
  <section class="hero" aria-labelledby="fs-page-title">
    <div class="hero-header">
      <span class="eyebrow">Credit Decisioning</span>
      <h1 id="fs-page-title">Financial spreading</h1>
      <p class="hero-subtitle">
        Extract financial statements into reviewed financials and
        credit-adjusted metrics
      </p>
    </div>
    <figure data-screenshot-slot="01">
      <div class="hero-stage">
        <div class="hero-story">
          <span class="eyebrow">Make the numbers work for you</span>
          <h2>Less preparation<br />More perspective</h2>
          <p>
            Move from financial statements to credit analysis faster with
            automated extraction that keeps your analysts in control
          </p>
          <a class="text-link" href="#fs-workflow"
            >See how it works <span class="arrow" aria-hidden="true">↗</span></a
          >
          <div class="quiet-line">
            <span class="check-circle" aria-hidden="true">✓</span> From source to
            credit-adjusted metrics
          </div>
        </div>
        <FinancialSpreadingWorkspace />
      </div>
      <figcaption class="figure-caption">
        <span>Illustrative views · Not actual screenshot · Fictional data</span
        ><!-- Screenshot 01 Replace the interface with a full multi-year spreading workspace -->
      </figcaption>
    </figure>
    <div class="outcomes" aria-label="Key benefits">
      <div class="outcome">
        <div class="outcome-top">
          <span class="index">01</span><h3>Less manual work</h3>
        </div><p>
          Start with extracted figures instead of rebuilding the numbers by hand
        </p>
      </div>
      <div class="outcome">
        <div class="outcome-top">
          <span class="index">02</span><h3>Confidence in the detail</h3>
        </div><p>
          Keep your analysis connected to the statements it comes from
        </p>
      </div>
      <div class="outcome">
        <div class="outcome-top">
          <span class="index">03</span><h3>A consistent credit view</h3>
        </div><p>
          Bring reviewed financials and credit-adjusted metrics into the rest of
          your decision process
        </p>
      </div>
    </div>
  </section>

  <section
    id="fs-workflow"
    class="workflow-section"
    aria-labelledby="fs-workflow-title"
  >
    <div class="workflow-heading">
      <div>
        <div class="eyebrow">From statement to understanding</div><h2
          id="fs-workflow-title"
        >
          Get to the credit picture<br />with the detail still in view
        </h2>
      </div><span class="pill">Your analysts stay in control</span>
    </div>
    <div class="workflow-grid">
      <div
        class="step-list"
        role="tablist"
        aria-label="Explore the spreading workflow"
        aria-orientation="vertical"
      >
        <button
          class="step-tab"
          id="fs-extract-tab"
          role="tab"
          aria-selected="true"
          aria-controls="fs-extract-panel"
          tabindex="0"
          ><span class="step-title"
            ><span class="step-number">01</span><span class="step-label"
              >Extract</span
            ><span class="step-chevron" aria-hidden="true">↗</span></span
          ><span class="step-copy"
            >Turn financial statements into a structured spread so your team can
            get straight to the analysis</span
          ></button
        >
        <button
          class="step-tab"
          id="fs-review-tab"
          role="tab"
          aria-selected="false"
          aria-controls="fs-review-panel"
          tabindex="-1"
          ><span class="step-title"
            ><span class="step-number">02</span><span class="step-label"
              >Review</span
            ><span class="step-chevron" aria-hidden="true">↗</span></span
          ><span class="step-copy"
            >Check figures against the source and use validation flags to focus
            attention where it matters</span
          ></button
        >
        <button
          class="step-tab"
          id="fs-adjust-tab"
          role="tab"
          aria-selected="false"
          aria-controls="fs-adjust-panel"
          tabindex="-1"
          ><span class="step-title"
            ><span class="step-number">03</span><span class="step-label"
              >Adjust</span
            ><span class="step-chevron" aria-hidden="true">↗</span></span
          ><span class="step-copy"
            >Apply your credit adjustments and see their impact on the metrics
            behind your decision</span
          ></button
        >
      </div>
      <div class="workflow-previews">
        <div
          id="fs-extract-panel"
          role="tabpanel"
          aria-labelledby="fs-extract-tab"
          data-screenshot-slot="02"
        >
          <p class="detail-mobile-copy">
            Turn financial statements into a structured spread so your team can
            get straight to the analysis
          </p>
          <div class="detail-window">
            <div class="detail-top">
              <strong>From source to spread</strong><small
                >Illustrative product view</small
              >
            </div>
            <div class="detail-body">
              <div class="paper-document">
                <div class="paper-heading">
                  Northstar Manufacturing<br />Annual report 2024
                </div><div class="paper-meta">
                  Consolidated income statement · EUR million
                </div><div class="paper-line"></div><div
                  class="paper-line short"
                >
                </div><div class="paper-table">
                  <div><span>Revenue</span><span>63.7</span></div><div>
                    <span>Cost of sales</span><span>(38.4)</span>
                  </div><div class="selected">
                    <span>EBITDA</span><span>12.4</span>
                  </div>
                </div><div class="paper-page">24</div>
              </div>
              <div class="transfer-arrow" aria-hidden="true">→</div>
              <div class="extracted-card">
                <h3>Structured financials</h3><div class="small-copy">
                  FY 2024 · EUR million
                </div><div class="extracted-value">
                  <span>Revenue</span><span class="value">63.7</span>
                </div><div class="extracted-value">
                  <span>Cost of sales</span><span class="value">(38.4)</span>
                </div><div class="extracted-value">
                  <span>EBITDA</span><span class="value">12.4</span>
                </div><span class="pill good">Ready for review</span>
              </div>
            </div>
            <div class="detail-bottom">
              <span class="check-circle" aria-hidden="true">✓</span> Extracted figures
              remain connected to the source
            </div>
          </div>
          <p class="figure-caption">
            Illustrative views · Not actual screenshot · Fictional data
          </p>
          <!-- Screenshot 02 Source statement beside the extracted financials with a matching figure highlighted -->
        </div>
        <div
          id="fs-review-panel"
          role="tabpanel"
          aria-labelledby="fs-review-tab"
          data-screenshot-slot="03"
          hidden=""
        >
          <p class="detail-mobile-copy">
            Check figures against the source and use validation flags to focus
            attention where it matters
          </p>
          <div class="detail-window">
            <div class="detail-top">
              <strong>Review with the source in view</strong><small
                >Illustrative product view</small
              >
            </div>
            <div class="detail-body">
              <div class="paper-document">
                <div class="paper-heading">
                  Northstar Manufacturing<br />Annual report 2023
                </div><div class="paper-meta">
                  Consolidated income statement · EUR million
                </div><div class="paper-line"></div><div
                  class="paper-line short"
                >
                </div><div class="paper-table">
                  <div><span>Revenue</span><span>58.1</span></div><div>
                    <span>Gross profit</span><span>22.9</span>
                  </div><div class="selected">
                    <span>EBITDA</span><span>10.6</span>
                  </div>
                </div><div class="paper-page">28</div>
              </div>
              <div class="transfer-arrow" aria-hidden="true">↔</div>
              <div class="extracted-card">
                <h3>EBITDA · FY 2023</h3><div class="extracted-value">
                  <span>Extracted value</span><span class="value">10.6</span>
                </div><div class="review-source">
                  Source: Annual report 2023 · Page 28
                </div><span class="pill good">Figure reviewed</span><div
                  class="review-status"
                >
                  1 other validation flag needs attention
                </div>
              </div>
            </div>
            <div class="detail-bottom">
              <span class="check-circle" aria-hidden="true">✓</span> Your analyst
              confirms the figures before they move forward
            </div>
          </div>
          <p class="figure-caption">
            Illustrative views · Not actual screenshot · Fictional data
          </p>
          <!-- Screenshot 03 Selected figure linked to its source location with the validation or review panel open -->
        </div>
        <div
          id="fs-adjust-panel"
          role="tabpanel"
          aria-labelledby="fs-adjust-tab"
          data-screenshot-slot="04"
          hidden=""
        >
          <p class="detail-mobile-copy">
            Apply your credit adjustments and see their impact on the metrics
            behind your decision
          </p>
          <div class="detail-window">
            <div class="detail-top">
              <strong>See the impact of your adjustments</strong><small
                >Illustrative product view</small
              >
            </div>
            <div class="adjust-body">
              <div class="adjust-heading">
                <strong>Credit adjustments · FY 2024</strong><span
                  >EUR million</span
                >
              </div>
              <table class="adjust-table">
                <thead
                  ><tr
                    ><th>Metric</th><th>Reported</th><th>Adjustment</th><th
                      >Adjusted</th
                    ></tr
                  ></thead
                ><tbody
                  ><tr
                    ><td>EBITDA</td><td>12.4</td><td>+1.2</td><td
                      class="adjusted">13.6</td
                    ></tr
                  ><tr
                    ><td>Net debt</td><td>34.0</td><td>0.0</td><td
                      class="adjusted">34.0</td
                    ></tr
                  ><tr
                    ><td>Net debt / EBITDA</td><td>2.74×</td><td
                      >Recalculated</td
                    ><td class="adjusted">2.50×</td></tr
                  ></tbody
                >
              </table>
              <div class="rationale">
                <strong>Analyst rationale</strong>One-off restructuring expense
                added back to EBITDA
              </div>
            </div>
            <div class="detail-bottom">
              <span class="check-circle" aria-hidden="true">✓</span> Reported figures
              and the credit-adjusted view stay distinct
            </div>
          </div>
          <p class="figure-caption">
            Illustrative views · Not actual screenshot · Fictional data
          </p>
          <!-- Screenshot 04 Reported and adjusted figures with the resulting ratios and an analyst rationale -->
        </div>
      </div>
    </div>
  </section>

  <section
    id="fs-connected"
    class="connected-section"
    aria-labelledby="fs-connected-title"
  >
    <div class="connected-copy">
      <span class="eyebrow">Part of the bigger decision</span><h2
        id="fs-connected-title"
      >
        Reviewed once<br />Ready for what’s next
      </h2><p>
        Carry reviewed financials and credit-adjusted metrics into Analytics and
        Memo so your credit scores and recommendations build on the same
        underlying numbers
      </p>
    </div>
    <div class="module-flow">
      <div class="module-flow-grid">
        <div class="module active">
          <div class="module-symbol">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
              ><rect x="4" y="4" width="16" height="16" rx="1"></rect><path
                d="m5 16 5-6 4 4 5-7"></path></svg
            >
          </div><h3>Financial spreading</h3><p>
            Reviewed financials and credit-adjusted metrics
          </p>
        </div>
        <a class="module" href="/credit-decisioning/analytics"
          ><div class="module-symbol">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"><path d="M6 20v-6m6 6V8m6 12V3"></path></svg
            >
          </div><h3>Analytics</h3><p>Transparent credit scores</p></a
        >
        <a class="module" href="/credit-decisioning/memo"
          ><div class="module-symbol">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
              ><path d="M6 3h8l4 4v14H6V3Z"></path><path
                d="M14 3v5h4M9 12h6m-6 4h6"></path></svg
            >
          </div><h3>Memo</h3><p>Decision-ready credit memos</p></a
        >
      </div>
      <div class="flow-footnote">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          aria-hidden="true"
          ><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"></path><path
            d="m8 12 3 3 5-6"></path></svg
        > Connected modules on one governed foundation
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="fs-closing-title">
    <div class="closing-copy">
      <h2 id="fs-closing-title">Interested?</h2><p>
        See how DecAltra can turn your financial statements into analysis
        your&nbsp;team&nbsp;can&nbsp;use
      </p>
    </div><div class="closing-actions">
      <button
        class="button"
        type="button"
        command="show-modal"
        commandfor="demo-request-modal">Request a demo</button
      ><a class="text-link" href="/contact"
        >Contact us <span class="arrow" aria-hidden="true">→</span></a
      >
    </div>
  </section>
</div>

<!-- Styles are scoped to this module by Astro; site navigation and other pages are unaffected. -->
<style>
  .financial-spreading-page {
    color-scheme: light;
    --page: #f1f3f3;
    --paper: #ffffff;
    --ink: #0b1011;
    --body: #526066;
    --muted: #69757a;
    --line: #dbe0e1;
    --soft: #f7f9f9;
    --dark: #0b0f10;
    --success: #396456;
    --success-bg: #edf4f0;
    --display: var(--font-display);
    --sans: var(--font-sans);
  }
  * {
    box-sizing: border-box;
  }
  .financial-spreading-page {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font: 15px/1.6 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  button,
  input {
    font: inherit;
  }
  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }
  button {
    cursor: pointer;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  h1,
  h2,
  h3,
  p,
  figure {
    margin: 0;
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-variation-settings: 'wdth' 112.5;
    font-weight: 450;
    letter-spacing: -0.045em;
  }
  p {
    color: var(--body);
  }
  button:focus-visible,
  a:focus-visible,
  summary:focus-visible,
  input:focus-visible {
    outline: 2px solid #477765;
    outline-offset: 5px;
  }
  [hidden] {
    display: none !important;
  }
  .wrap {
    width: min(1280px, calc(100% - 80px));
    margin-inline: auto;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 5px 11px;
    font-size: 11px;
    line-height: 1.35;
    white-space: nowrap;
  }
  .pill.good {
    color: var(--success);
    background: var(--success-bg);
    border-color: #dae8df;
  }
  .pill.good::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }
  .arrow {
    font-family: Arial, sans-serif;
    font-size: 21px;
    line-height: 1;
  }
  .button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    background: var(--ink);
    color: white;
    border: 1px solid var(--ink);
    padding: 12px 21px;
    border-radius: 100px;
    font-weight: 550;
    font-size: 13px;
    white-space: nowrap;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .button:hover {
    background: #303a3c;
    transform: translateY(-1px);
  }
  .text-link {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    border: 0;
    padding: 8px 0;
    background: transparent;
    font-size: 13px;
    font-weight: 550;
  }
  .hero {
    padding: 46px 0 0;
  }
  .hero-header {
    text-align: center;
    margin-bottom: 42px;
  }
  .hero-header .eyebrow {
    display: inline-flex;
    padding: 5px 12px;
    border: 1px solid #d3dada;
    border-radius: 99px;
    background: #ffffff80;
    font-weight: 500;
  }
  h1 {
    font-size: clamp(35px, 4.5vw, 60px);
    line-height: 1.15;
    margin: 21px 0 15px;
  }
  .hero-subtitle {
    font-size: 18px;
    line-height: 1.7;
  }
  .hero-stage {
    display: grid;
    grid-template-columns: minmax(220px, 0.78fr) minmax(0, 2fr);
    gap: 36px;
    align-items: center;
    background: linear-gradient(122deg, #e8ecec, #e5e9e9 65%, #edf0ef);
    padding: 40px 0 40px 40px;
    border: 1px solid #dce1e1;
    border-radius: 22px;
    position: relative;
    overflow: hidden;
  }
  .hero-story {
    padding: 6px 0 6px 0;
    position: relative;
    z-index: 1;
  }
  .hero-story .eyebrow {
    color: #657176;
    font-size: 10px;
  }
  .hero-story h2 {
    font-size: 32px;
    line-height: 1.18;
    margin: 15px 0 19px;
  }
  .hero-story p {
    font-size: 14px;
    line-height: 1.9;
    max-width: 265px;
  }
  .hero-story .text-link {
    margin-top: 24px;
    font-size: 12px;
  }
  .hero-story .quiet-line {
    margin-top: 32px;
    padding-top: 15px;
    border-top: 1px solid #cbd3d3;
    display: flex;
    gap: 9px;
    align-items: center;
    font-size: 11px;
    color: #5b686c;
  }
  .check-circle {
    flex-shrink: 0;
    display: inline-flex;
    width: 19px;
    height: 19px;
    align-items: center;
    justify-content: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 11px;
  }
  .workspace {
    min-width: 0;
    background: white;
    border: 1px solid #ccd3d3;
    border-radius: 13px 0 0 13px;
    box-shadow: 0 20px 50px #1b32331a;
    margin-right: -1px;
    overflow: hidden;
  }
  .workspace-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    min-height: 49px;
    padding: 12px 20px;
    border-bottom: 1px solid #e6eaea;
  }
  .workspace-mark {
    font-family: var(--display);
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -0.6px;
  }
  .workspace-label {
    font-size: 10px;
    color: #6a777c;
  }
  .workspace-body {
    display: grid;
    grid-template-columns: 133px minmax(0, 1fr);
    min-height: 318px;
  }
  .app-sidebar {
    border-right: 1px solid #e8ebeb;
    padding: 19px 10px;
    background: #fafbfb;
  }
  .company-monogram {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    font-weight: 600;
    margin: 0 5px 23px;
  }
  .monogram {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 26px;
    height: 26px;
    background: #e3e9e7;
    border: 1px solid #d4dfda;
    border-radius: 7px;
    font-size: 10px;
  }
  .app-menu-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    padding: 9px 8px;
    color: #68777c;
    margin-bottom: 3px;
    border-radius: 6px;
  }
  .app-menu-item.active {
    background: #e9eeee;
    color: var(--ink);
    font-weight: 600;
  }
  .app-menu-item svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }
  .workspace-content {
    padding: 19px 21px 17px;
    min-width: 0;
  }
  .workspace-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 17px;
  }
  .workspace-title strong {
    display: block;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.35px;
  }
  .workspace-title small {
    display: block;
    font-size: 10px;
    color: #708087;
    margin-top: 2px;
  }
  .workspace-title .pill {
    font-size: 9px;
    padding: 4px 7px;
  }
  .app-tabs {
    display: flex;
    gap: 22px;
    border-bottom: 1px solid #e2e7e7;
    margin-bottom: 13px;
    font-size: 10px;
    color: #758188;
  }
  .app-tabs span {
    padding: 0 0 9px;
  }
  .app-tabs .active {
    border-bottom: 2px solid var(--ink);
    color: var(--ink);
    font-weight: 600;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .spread-table {
    font-size: 10px;
  }
  th {
    font-weight: 500;
    color: #728086;
  }
  .spread-table th,
  .spread-table td {
    padding: 8px 10px;
    border-bottom: 1px solid #edf0f0;
    text-align: right;
    white-space: nowrap;
  }
  .spread-table th:first-child,
  .spread-table td:first-child {
    text-align: left;
    padding-left: 0;
  }
  .spread-table .highlight {
    background: #edf3f0;
  }
  .spread-table .highlight td:first-child {
    padding-left: 8px;
  }
  .spread-table .highlight td {
    font-weight: 600;
    color: #244d40;
  }
  .workspace-bottom {
    margin-top: 15px;
    font-size: 9px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: #62756a;
  }
  .workspace-bottom .tiny-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #6b927d;
  }
  .figure-caption {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 2px 0;
    font-size: 11px;
    color: #778287;
  }
  .outcomes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 34px 0 48px;
  }
  .outcome {
    padding: 0 32px;
    border-right: 1px solid #d9dfdf;
  }
  .outcome:first-child {
    padding-left: 0;
  }
  .outcome:last-child {
    border-right: 0;
    padding-right: 0;
  }
  .outcome-top {
    display: flex;
