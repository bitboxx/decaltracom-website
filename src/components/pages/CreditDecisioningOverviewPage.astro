<script>
  const root = document.querySelector<HTMLElement>('[data-credit-overview]');
  if (root) {
    const closing = root.querySelector<HTMLElement>('#call-to-action');
    const footer = document.getElementById('footer');
    if (closing && footer) {
      let endSpace = 0;
      const updateEndSpace = () => {
        const headerOffset =
          Number.parseFloat(
            getComputedStyle(document.documentElement).scrollPaddingTop
          ) || 0;
        const sectionOffset =
          Number.parseFloat(getComputedStyle(closing).scrollMarginTop) || 0;
        const naturalRemainingHeight =
          footer.getBoundingClientRect().bottom -
          closing.getBoundingClientRect().top -
          endSpace;
        const requiredSpace = Math.max(
          0,
          Math.round(
            window.innerHeight -
              headerOffset -
              sectionOffset -
              naturalRemainingHeight
          )
        );
        if (requiredSpace === endSpace) return;
        endSpace = requiredSpace;
        footer.style.setProperty(
          '--credit-overview-end-space',
          `${endSpace}px`
        );
      };
      // Only add the scroll room needed to align the final section, even on tall screens.
      const endObserver = new ResizeObserver(updateEndSpace);
      endObserver.observe(closing);
      endObserver.observe(footer);
      window.addEventListener('resize', updateEndSpace);
      updateEndSpace();
    }
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('.step-tab')
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>('[role="tabpanel"]')
    );
    const tablist = root.querySelector<HTMLElement>('.step-list');
    const orientation = window.matchMedia('(max-width:900px)');
    function selectTab(tab: HTMLButtonElement, focus = false) {
      for (const item of tabs) {
        const active = item === tab;
        item.setAttribute('aria-selected', String(active));
        item.tabIndex = active ? 0 : -1;
      }
      for (const panel of panels)
        panel.hidden = panel.id !== tab.getAttribute('aria-controls');
      if (focus) tab.focus();
    }
    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', event => {
        let next: number;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight')
          next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft')
          next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        selectTab(tabs[next], true);
      });
    }
    function updateOrientation() {
      tablist?.setAttribute(
        'aria-orientation',
        orientation.matches ? 'horizontal' : 'vertical'
      );
    }
    orientation.addEventListener('change', updateOrientation);
    updateOrientation();
    const citations = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-source-target]')
    );
    const sources = Array.from(
      root.querySelectorAll<HTMLElement>('[data-source-panel]')
    );
    for (const citation of citations) {
      citation.addEventListener('click', () => {
        const target = citation.dataset.sourceTarget;
        if (!target) return;
        for (const button of citations)
          button.setAttribute(
            'aria-pressed',
            String(button.dataset.sourceTarget === target)
          );
        for (const source of sources) source.hidden = source.id !== target;
      });
    }
  }
</script>
