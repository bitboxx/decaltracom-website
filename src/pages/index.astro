---
import Layout from '../layouts/Layout.astro';
import HomePage from '@/components/pages/HomePage';
import PortfolioWorkspace from '@/components/illustrations/PortfolioWorkspace.astro';
import FinancialSpreadingWorkspace from '@/components/illustrations/FinancialSpreadingWorkspace.astro';
import AnalyticsWorkspace from '@/components/illustrations/AnalyticsWorkspace.astro';
import MemoWorkspace from '@/components/illustrations/MemoWorkspace.astro';
---

<Layout title="DecAltra - Financial decision making infrastructure">
  <HomePage client:load>
    <div
      data-platform-slide="0"
      role="group"
      aria-roledescription="slide"
      aria-label="1 of 4: Portfolio overview"
    >
      <PortfolioWorkspace />
    </div>
    <div
      data-platform-slide="1"
      role="group"
      aria-roledescription="slide"
      aria-label="2 of 4: Financial Spreading"
    >
      <FinancialSpreadingWorkspace />
    </div>
    <div
      data-platform-slide="2"
      role="group"
      aria-roledescription="slide"
      aria-label="3 of 4: Analytics"
    >
      <AnalyticsWorkspace />
    </div>
    <div
      data-platform-slide="3"
      role="group"
      aria-roledescription="slide"
      aria-label="4 of 4: Memo"
    >
      <MemoWorkspace />
    </div>
  </HomePage>
</Layout>
