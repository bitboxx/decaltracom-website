---
import '../styles/global.css'
import { Main } from '@/components/elements/main'
import DemoRequestModal from '@/components/pages/DemoRequestModal'
import FeedbackModal from '@/components/pages/FeedbackModal'
import MessageModal from '@/components/pages/MessageModal'
import RequestCallModal from '@/components/pages/RequestCallModal'
import Navbar from '@/components/pages/Navbar'
import Footer from '@/components/pages/Footer'
import CookieNotice from '@/components/pages/CookieNotice'

interface Props {
  title: string
  description?: string
}

const { title, description = 'AI-enabled decision infrastructure for capital providers' } = Astro.props

// Simple Analytics: Dutch, EU-hosted, cookieless. Inert unless
// PUBLIC_ANALYTICS is "on", so local and preview builds send nothing.
const analyticsEnabled = import.meta.env.PUBLIC_ANALYTICS === 'on'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Navbar client:load />
    <Main>
      <slot />
    </Main>
    <DemoRequestModal client:load />
    <FeedbackModal client:load />
    <MessageModal client:load />
    <RequestCallModal client:load />
    <Footer />
    <CookieNotice client:load />
    {analyticsEnabled && <script is:inline async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>}
  </body>
</html>
